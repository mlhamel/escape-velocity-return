{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "evr-game": {
      "type": "local",
      "command": ["cargo", "run", "-p", "evr-mcp"],
      "enabled": true
    }
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "cargo build*": "allow",
      "cargo test*": "allow",
      "cargo check*": "allow",
      "cargo clippy*": "allow",
      "cargo fmt*": "allow"
    }
  }
}