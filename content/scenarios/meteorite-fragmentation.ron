(
    id: "meteorite-fragmentation",
    name: "Meteorite Binary Fragmentation & Collision Hazard",
    description: "Verifies that shooting a Large meteorite splits it into 2 Medium parts, then 4 Small parts, and finally disappears, and that crashing into a meteorite damages the ship.",
    max_ticks: 2000,
    steps: [
        AssertSystem("sol"),
        ClearMeteorites,
        SpawnMeteorite(size: "large", offset: (90.0, 0.0), velocity: (0.0, 0.0)),
        AssertMeteorites(count: 1, size: Some("large")),
        DestroyNearestMeteorite,
        AssertMeteorites(count: 2, size: Some("medium")),
        DestroyNearestMeteorite,
        DestroyNearestMeteorite,
        AssertMeteorites(count: 4, size: Some("small")),
        DestroyNearestMeteorite,
        DestroyNearestMeteorite,
        DestroyNearestMeteorite,
        DestroyNearestMeteorite,
        AssertMeteorites(count: 0, size: None),
        SpawnMeteorite(size: "large", offset: (12.0, 0.0), velocity: (-35.0, 0.0)),
        Advance(ticks: 15),
        AssertAlive(true),
    ],
)
